<Window x:Class="AgingTest.Views.CommunicationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AgingTest.Views"
        mc:Ignorable="d"
        Title="通讯设置" Height="960" Width="1500"
        WindowStartupLocation="CenterOwner"
        Background="#EFF2F7">
    <Window.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28a745"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="InputCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="IsEditable" Value="True"/>
        </Style>
        <Style x:Key="InputTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#1F3864">
            <Grid>
                <TextBlock Text="设备通讯设置" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="连接全部" Style="{StaticResource SuccessButton}" Click="BtnConnectAll_Click" Margin="0,0,8,0"/>
                    <Button Content="断开全部" Style="{StaticResource DangerButton}" Click="BtnDisconnectAll_Click" Margin="0,0,8,0"/>
                    <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">

                <!-- 电子负载 2 台 -->
                <GroupBox Header="电子负载（GJDA-100-32 ×2 · RS485 串口）" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel x:Name="LoadPanel"/>
                </GroupBox>

                <!-- 485 总线（电阻 + 继电器共用） -->
                <GroupBox Header="485 总线（电阻模拟卡 + 继电器板共用 ×6 · 每路挂电阻地址1~4、继电器地址17~20）" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="每路 485 总线 = 1 个串口，同时挂 4 个电阻模拟卡（地址1~4）与 4 个继电器板（地址17~20）。" FontSize="11" Foreground="#888" Margin="0,0,0,6"/>
                        <StackPanel x:Name="RrPanel"/>
                    </StackPanel>
                </GroupBox>

                <!-- 大电流程控电源 N36100 -->
                <GroupBox Header="大电流程控电源（N36100 ×6 · SCPI · TCP）" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel x:Name="N36100Panel"/>
                </GroupBox>

                <!-- 高精度程控电源 N36600 -->
                <GroupBox Header="高精度程控电源（N36600 ×6 · SCPI · TCP）" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel x:Name="N36600Panel"/>
                </GroupBox>

                <!-- CAN 卡 ZLG-800H -->
                <GroupBox Header="CAN 卡（ZLG-800H ×6 · 网口）" Style="{StaticResource GroupBoxStyle}">
                    <local:UC_CanZlg800H/>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
