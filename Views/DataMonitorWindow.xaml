<Window x:Class="AgingTest.Views.DataMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据监控详情"
        Height="960" Width="1050"
        MinHeight="840" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="#EFF2F7" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="DataCard" TargetType="Border">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F3864"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CtrlButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CtrlToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E3E8F0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#C9D2E0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部信息栏 ===== -->
        <Border Grid.Row="0" Background="#1F3864" CornerRadius="6">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="工位" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailStation" Text="1-1" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="产品二维码" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailProduct" Text="--" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="状态" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailState" Text="空闲" FontSize="15" FontWeight="Bold" Foreground="#7EE0A0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="测试类型" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailType" Text="--" FontSize="14" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="剩余时间" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailRemain" Text="--" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="老化步骤" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailAgingStep" Text="--" FontSize="13" FontWeight="Bold" Foreground="#FFD9A8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="UDS 数据" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtUdsState" Text="未连接" FontSize="13" FontWeight="Bold" Foreground="#FFD9A8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDetailCount" Text="刷新 0" FontSize="10" Foreground="#AFC4E8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 实时采集数据（全部来自 BMS UDS 22 服务读取，按附录1 解析） ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：单体电压 4 通道，DID 7397~739A，uint16×0.001 V -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V1" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV1" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V2" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV2" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V3" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV3" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V4" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV4" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第2行：总压2通道 + 电流 + SOC，DID 739B/739C/7396/7391 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DataCard}" Background="#F0ECFF">
                    <StackPanel><TextBlock Text="内总压 B+ (739B)" FontSize="11" Foreground="#5A4A8C"/><TextBlock x:Name="TxtInnerV" Text="--" FontSize="17" FontWeight="Bold" Foreground="#3A2A6C" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DataCard}" Background="#F0ECFF">
                    <StackPanel><TextBlock Text="外总压 P+ (739C)" FontSize="11" Foreground="#5A4A8C"/><TextBlock x:Name="TxtOuterV" Text="--" FontSize="17" FontWeight="Bold" Foreground="#3A2A6C" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DataCard}" Background="#E8F8EF">
                    <StackPanel><TextBlock Text="总电流 (7396)" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtCurr" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource DataCard}" Background="#E8F8EF">
                    <StackPanel><TextBlock Text="SOC (7391)" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtSoc" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第3行：电芯温度 + 充/放电 MOS 温度，uint8−40 ℃ -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="电芯温度 T1 (73A3)" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtT1" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="电芯温度 T2 (73A4)" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtT2" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="充电 MOS 温度 (73A6)" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtChargeMosT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="放电 MOS 温度 (73A5)" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtDischargeMosT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第4行：限流模块/板子温度 + 压差汇总 -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="限流模块温度 (73A7)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtBuckT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="板子温度 (73A8)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtBoardT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="单体压差 (Vmax−Vmin)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtCellDelta" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="总压差 (P+−B+)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtPackDelta" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 本工位所在层：大电流电源 / 高精度电源回采 ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="电源回采" FontSize="12" FontWeight="Bold" Foreground="#1F3864"/>
                    <TextBlock x:Name="TxtPowerLayer" Text="第 1 层" FontSize="11" Foreground="#7A8699" Margin="10,0,0,0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DataCard}" Background="#EAF7F0">
                        <StackPanel><TextBlock Text="大电流电源 N36190 电压" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtBigV" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DataCard}" Background="#EAF7F0">
                        <StackPanel><TextBlock Text="大电流电源 N36190 电流" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtBigA" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DataCard}" Background="#EAF1FF">
                        <StackPanel><TextBlock Text="高精度电源 N36620 电压" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtSmallV" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource DataCard}" Background="#EAF1FF">
                        <StackPanel><TextBlock Text="高精度电源 N36620 电流" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtSmallA" Text="--" FontSize="16" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>


        <!-- ===== 本工位 CAN 报文监视（老化、唤醒、UDS 诊断实时收发） ===== -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="本工位 CAN 报文监视" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <Ellipse x:Name="CanLinkDot" Width="9" Height="9" Fill="#B0B6C0" Margin="12,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCanLink" Text="CAN1 / CH0" FontSize="12" FontWeight="Bold" Foreground="#2F6FED" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCanLinkState" Text="未启动" FontSize="11" Foreground="#888" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtFrameCount" Text="报文 0" FontSize="11" Foreground="#7A8699" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <DataGrid x:Name="GridCanFrames" Grid.Row="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="#F7F9FC"
                          Background="#FBFCFE" BorderThickness="0" FontSize="11"
                          HorizontalGridLinesBrush="#E8EDF5" VerticalGridLinesBrush="#E8EDF5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="86"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="70"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="88"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="54"/>
                        <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="46"/>
                        <DataGridTextColumn Header="数据" Binding="{Binding Data}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ===== 实时曲线 ===== -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="0,0,5,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="单体电压曲线 (V)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurV" Text="--" FontSize="12" FontWeight="Bold" Foreground="#2F6FED" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasVoltage" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineVoltage" Stroke="#2F6FED" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="4.5" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="3.75" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="3.0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="5,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="温度曲线 (℃)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurT" Text="--" FontSize="12" FontWeight="Bold" Foreground="#ED7A2C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasTemp" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineTemp" Stroke="#ED7A2C" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="100" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="50" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="5,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="电流曲线 (A)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurI" Text="--" FontSize="12" FontWeight="Bold" Foreground="#1E7A44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasCurrent" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineCurrent" Stroke="#1E7A44" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="10" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="5" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 故障诊断栏 ===== -->
        <Border Grid.Row="5" Background="#FFF4F4" BorderBrush="#E5C4C4" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="故障诊断：" FontSize="12" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDetailFault" Grid.Column="1" Text="正常" FontSize="13" FontWeight="Bold" Foreground="#2FA84F" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="DTC：" FontSize="12" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="TxtDetailDtc" Grid.Column="3" Text="无" FontSize="13" FontWeight="Bold" Foreground="#2FA84F" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
