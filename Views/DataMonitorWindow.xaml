<Window x:Class="AgingTest.Views.DataMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据监控详情"
        Height="900" Width="1050"
        MinHeight="780" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="#EFF2F7" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="DataCard" TargetType="Border">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F3864"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CtrlButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CtrlToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E3E8F0"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#C9D2E0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部信息栏 ===== -->
        <Border Grid.Row="0" Background="#1F3864" CornerRadius="6">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="工位" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailStation" Text="1-1" FontSize="18" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="产品二维码" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailProduct" Text="--" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="状态" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailState" Text="空闲" FontSize="15" FontWeight="Bold" Foreground="#7EE0A0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="测试类型" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailType" Text="--" FontSize="14" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBlock Text="剩余时间" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailRemain" Text="--" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                    <TextBlock Text="老化步骤" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailAgingStep" Text="--" FontSize="13" FontWeight="Bold" Foreground="#FFD9A8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="刷新" FontSize="11" Foreground="#AFC4E8"/>
                    <TextBlock x:Name="TxtDetailCount" Text="0" FontSize="14" Foreground="#FFD9A8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 数据卡片区（按文档产品功能说明） ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 第1行：单体电压采集 4通道 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V1" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV1" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V2" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV2" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V3" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV3" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource DataCard}" Background="#EAF1FF">
                    <StackPanel><TextBlock Text="单体电压 V4" FontSize="11" Foreground="#5A6B8C"/><TextBlock x:Name="TxtV4" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1F3864" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第2行：总压2通道 + 电流 + 工作电压 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DataCard}" Background="#F0ECFF">
                    <StackPanel><TextBlock Text="内总压 (MOS内)" FontSize="11" Foreground="#5A4A8C"/><TextBlock x:Name="TxtInnerV" Text="--" FontSize="17" FontWeight="Bold" Foreground="#3A2A6C" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DataCard}" Background="#F0ECFF">
                    <StackPanel><TextBlock Text="外总压 (MOS外)" FontSize="11" Foreground="#5A4A8C"/><TextBlock x:Name="TxtOuterV" Text="--" FontSize="17" FontWeight="Bold" Foreground="#3A2A6C" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DataCard}" Background="#E8F8EF">
                    <StackPanel><TextBlock Text="电流" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtCurr" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource DataCard}" Background="#E8F8EF">
                    <StackPanel><TextBlock Text="工作电压 (6~18V)" FontSize="11" Foreground="#3E7A54"/><TextBlock x:Name="TxtWorkV" Text="--" FontSize="17" FontWeight="Bold" Foreground="#1E7A44" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第3行：温度采集2通道 + MOS温度 + 工作温度 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="电芯温度 T1" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtT1" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="电芯温度 T2" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtT2" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="MOS温度" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtMosT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource DataCard}" Background="#FFF3E6">
                    <StackPanel><TextBlock Text="工作温度 (-40~105℃)" FontSize="11" Foreground="#8C6A4A"/><TextBlock x:Name="TxtWorkT" Text="--" FontSize="17" FontWeight="Bold" Foreground="#C0500F" TextAlignment="Center"/></StackPanel>
                </Border>

                <!-- 第4行：SOC / SOH / 工作功耗 / 均衡电流 -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="SOC (精度5%)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtSoc" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="SOH (精度8%)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtSoh" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="工作功耗 (&lt;100mA)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtWorkP" Text="--" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
                <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource DataCard}" Background="#FDF4EC">
                    <StackPanel><TextBlock Text="均衡电流 (40~120mA)" FontSize="11" Foreground="#8C6A3A"/><TextBlock x:Name="TxtBalance" Text="0 mA" FontSize="17" FontWeight="Bold" Foreground="#B06610" TextAlignment="Center"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 控制功能区 ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- MOS / 继电器控制 -->
                <Border Grid.Row="0" Grid.Column="0" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="MOS / 继电器控制" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnMosClose" Content="MOS 闭合" Style="{StaticResource CtrlButton}" Background="#2FA84F" Click="BtnMosClose_Click" AutomationProperties.AutomationId="BtnMosClose"/>
                            <Button x:Name="BtnMosOpen" Content="MOS 断开" Style="{StaticResource CtrlButton}" Background="#E5484D" Click="BtnMosOpen_Click" AutomationProperties.AutomationId="BtnMosOpen"/>
                            <Ellipse x:Name="MosLight" Width="12" Height="12" Fill="#B0B6C0" VerticalAlignment="Center" Margin="2,0,6,0"/>
                            <TextBlock x:Name="TxtMosState" Text="已断开" FontSize="12" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="带载条件：BMS 输入正常、MOS 闭合" FontSize="10" Foreground="#999" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 均衡管理 -->
                <Border Grid.Row="0" Grid.Column="1" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,0,0,4">
                    <StackPanel>
                        <TextBlock Text="均衡管理（4路被动均衡）" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="TogBal1" Content="均衡1" Style="{StaticResource CtrlToggle}" Tag="0" Checked="Bal_Changed" Unchecked="Bal_Changed" AutomationProperties.AutomationId="TogBal1"/>
                            <ToggleButton x:Name="TogBal2" Content="均衡2" Style="{StaticResource CtrlToggle}" Tag="1" Checked="Bal_Changed" Unchecked="Bal_Changed" AutomationProperties.AutomationId="TogBal2"/>
                            <ToggleButton x:Name="TogBal3" Content="均衡3" Style="{StaticResource CtrlToggle}" Tag="2" Checked="Bal_Changed" Unchecked="Bal_Changed" AutomationProperties.AutomationId="TogBal3"/>
                            <ToggleButton x:Name="TogBal4" Content="均衡4" Style="{StaticResource CtrlToggle}" Tag="3" Checked="Bal_Changed" Unchecked="Bal_Changed" AutomationProperties.AutomationId="TogBal4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="均衡失效自诊断：" FontSize="10" Foreground="#999"/>
                            <TextBlock x:Name="TxtBalDiag" Text="正常" FontSize="11" FontWeight="Bold" Foreground="#2FA84F"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 休眠 / 唤醒 -->
                <Border Grid.Row="1" Grid.Column="0" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,4,4,0">
                    <StackPanel>
                        <TextBlock Text="休眠 / 唤醒" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="浅休眠" Style="{StaticResource CtrlButton}" Background="#7A5AA8" Tag="light" Click="SleepCmd_Click" AutomationProperties.AutomationId="BtnSleepLight"/>
                            <Button Content="深度休眠" Style="{StaticResource CtrlButton}" Background="#5A3A88" Tag="deep" Click="SleepCmd_Click" AutomationProperties.AutomationId="BtnSleepDeep"/>
                            <Button Content="CAN 唤醒" Style="{StaticResource CtrlButton}" Background="#2F6FED" Tag="wakecan" Click="SleepCmd_Click" AutomationProperties.AutomationId="BtnWakeCan"/>
                            <Button Content="低电平唤醒" Style="{StaticResource CtrlButton}" Background="#2F6FED" Tag="wakelow" Click="SleepCmd_Click" AutomationProperties.AutomationId="BtnWakeLow"/>
                            <Button Content="帮电唤醒" Style="{StaticResource CtrlButton}" Background="#2F6FED" Tag="wakepower" Click="SleepCmd_Click" AutomationProperties.AutomationId="BtnWakePower"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSleepState" Text="当前状态：正常唤醒" FontSize="11" FontWeight="Bold" Foreground="#2FA84F" Margin="0,3,0,0"/>
                        <TextBlock Text="唤醒方式：CAN唤醒 / 低电平硬线唤醒(接模拟电池GND) / 帮电唤醒" FontSize="10" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 通信信息 -->
                <Border Grid.Row="1" Grid.Column="1" Background="#F7F9FC" BorderBrush="#E3E8F0" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="4,4,0,0">
                    <StackPanel>
                        <TextBlock Text="通信信息" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="CAN：波特率 500k" FontSize="11" Foreground="#444" Margin="0,2,0,0"/>
                        <TextBlock Text="CANFD：波特率 500k / 2M" FontSize="11" Foreground="#444"/>
                        <TextBlock Text="LIN：预留（支持LIN通信老化方案）" FontSize="11" Foreground="#444"/>
                        <TextBlock Text="轮询间隔：由主界面参数设定" FontSize="10" Foreground="#999" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 实时曲线 ===== -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="0,0,5,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="单体电压曲线 (V)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurV" Text="--" FontSize="12" FontWeight="Bold" Foreground="#2F6FED" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasVoltage" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineVoltage" Stroke="#2F6FED" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="4.5" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="3.75" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="3.0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="5,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="温度曲线 (℃)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurT" Text="--" FontSize="12" FontWeight="Bold" Foreground="#ED7A2C" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasTemp" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineTemp" Stroke="#ED7A2C" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="100" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="50" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="5,0,0,0" Padding="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="电流曲线 (A)" FontSize="12" FontWeight="Bold" Foreground="#1F3864" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurI" Text="--" FontSize="12" FontWeight="Bold" Foreground="#1E7A44" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Canvas x:Name="CanvasCurrent" ClipToBounds="True" Background="#FBFCFE"><Polyline x:Name="LineCurrent" Stroke="#1E7A44" StrokeThickness="2"/></Canvas>
                        <Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Top"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Center"/><Rectangle Height="1" Fill="#E0E6EF" VerticalAlignment="Bottom"/>
                        <TextBlock Text="10" FontSize="9" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                        <TextBlock Text="5" FontSize="9" Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,-7,0,0"/>
                        <TextBlock Text="0" FontSize="9" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,-14,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 故障诊断栏 ===== -->
        <Border Grid.Row="4" Background="#FFF4F4" BorderBrush="#E5C4C4" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="故障诊断：" FontSize="12" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtDetailFault" Grid.Column="1" Text="正常" FontSize="13" FontWeight="Bold" Foreground="#2FA84F" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="DTC：" FontSize="12" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="TxtDetailDtc" Grid.Column="3" Text="无" FontSize="13" FontWeight="Bold" Foreground="#2FA84F" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
