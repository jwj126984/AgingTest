<Window x:Class="AgingTest.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户登录"
        Width="420" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1F3864"
        WindowStyle="SingleBorderWindow">
    <Grid>
        <Border Background="#1F3864" Padding="32,28">
            <StackPanel>
                <TextBlock Text="奇瑞C1068 老化柜测试上位机" FontSize="19" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="用户登录" FontSize="14" Foreground="#AFC4E8" HorizontalAlignment="Center" Margin="0,6,0,22"/>

                <TextBlock Text="用户名" FontSize="12" Foreground="#AFC4E8" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUserName" Height="34" FontSize="14" VerticalContentAlignment="Center"
                         Padding="8,0" Background="#F5F7FB" BorderThickness="0"
                         KeyDown="Input_KeyDown" AutomationProperties.AutomationId="LoginUserName"/>

                <TextBlock Text="密码" FontSize="12" Foreground="#AFC4E8" Margin="0,14,0,4"/>
                <PasswordBox x:Name="PwdPassword" Height="34" FontSize="14" VerticalContentAlignment="Center"
                             Padding="8,0" Background="#F5F7FB" BorderThickness="0"
                             KeyDown="Input_KeyDown" AutomationProperties.AutomationId="LoginPassword"/>

                <!-- 记住密码：用户名始终自动加载；勾选后连密码一起记住 -->
                <CheckBox x:Name="ChkRemember" Content="记住密码（自动加载上次登录账号）" Foreground="#D5E1F5" FontSize="12"
                          Margin="0,10,0,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="LoginRemember" Checked="ChkRemember_Checked" Unchecked="ChkRemember_Checked"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnLogin" Grid.Column="0" Content="登  录" Height="38" FontSize="15" FontWeight="Bold"
                            Foreground="White" Background="#2F80ED" BorderThickness="0" Cursor="Hand"
                            Click="BtnLogin_Click" AutomationProperties.AutomationId="LoginBtn"/>
                    <Button x:Name="BtnCancel" Grid.Column="2" Content="退  出" Height="38" FontSize="15" FontWeight="Bold"
                            Foreground="#333" Background="#E3E8F0" BorderThickness="0" Cursor="Hand"
                            Click="BtnCancel_Click" AutomationProperties.AutomationId="LoginCancelBtn"/>
                </Grid>

                <TextBlock x:Name="TxtLoginMsg" Text="" FontSize="12" Foreground="#FFD9A8" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MinHeight="18"/>
                <TextBlock Text="默认账号：operator（作业员）/ tech（技术员）/ engineer（工程师）&#10;密码均为 123456"
                           FontSize="11" Foreground="#7C8DB0" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
