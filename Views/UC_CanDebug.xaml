<UserControl x:Class="AgingTest.Views.UC_CanDebug"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1250"
             Background="#F4F6F9"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F27022"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="RootScroll_PreviewMouseWheel">
        <StackPanel Margin="4">

            <!-- 卡/通道选择 -->
            <GroupBox Header="卡 / 通道选择" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CAN卡:" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="CmbCard" Width="70" SelectedIndex="0"/>
                    <TextBlock Text="通道(0~7):" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                    <ComboBox x:Name="CmbCh" Width="70" SelectedIndex="0"/>
                    <TextBlock x:Name="TxtOnline" Text="在线状态：未知" VerticalAlignment="Center" Foreground="#888" Margin="18,0,0,0" FontSize="12"/>
                    <TextBlock x:Name="TxtChState" Text="" VerticalAlignment="Center" Foreground="#888" Margin="14,0,0,0" FontSize="12"/>
                </StackPanel>
            </GroupBox>

            <!-- 发送区 -->
            <GroupBox Header="发送 CAN / CANFD 帧" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ID(hex):" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox x:Name="TxtId" Width="90" Text="100" FontFamily="Consolas"/>
                        <TextBlock Text="帧类型:" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"/>
                        <ComboBox x:Name="CmbFrameType" Width="110" SelectedIndex="0">
                            <ComboBoxItem Content="CAN 2.0"/>
                            <ComboBoxItem Content="CANFD"/>
                            <ComboBoxItem Content="远程帧(RTR)"/>
                        </ComboBox>
                        <CheckBox x:Name="ChkExt" Content="扩展帧(29位)" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
                        <Button Content="发送" Style="{StaticResource PrimaryButton}" Click="BtnSend_Click" Margin="14,0,0,0"/>
                        <TextBlock x:Name="TxtSendResult" Text="" VerticalAlignment="Center" Foreground="#28a745" Margin="14,0,0,0" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="数据(hex,空格分隔):" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox x:Name="TxtData" Width="560" Text="" FontFamily="Consolas"/>
                        <TextBlock Text="长度自动按字节计算" VerticalAlignment="Center" Foreground="#888" Margin="10,0,0,0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 实时接收监视 -->
            <GroupBox Header="实时接收监视" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="BtnToggleRecv" Content="暂停显示" Style="{StaticResource WarningButton}" Click="BtnToggleRecv_Click"/>
                        <Button Content="清空显示" Style="{StaticResource PrimaryButton}" Click="BtnClearView_Click" Margin="8,0,0,0"/>
                        <TextBlock Text="显示帧数:" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>
                        <TextBlock x:Name="TxtRecvCount" Text="0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="（最多保留最近1000帧）" VerticalAlignment="Center" Foreground="#888" Margin="10,0,0,0" FontSize="11"/>
                    </StackPanel>
                    <DataGrid x:Name="DgFrames" Height="320" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="All" FontFamily="Consolas" FontSize="12"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F7F9FC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat={}{0:HH:mm:ss.fff}}" Width="105"/>
                            <DataGridTextColumn Header="卡" Binding="{Binding CanIndex}" Width="45"/>
                            <DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="50"/>
                            <DataGridTextColumn Header="ID(hex)" Binding="{Binding IdText}" Width="90"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70"/>
                            <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="50"/>
                            <DataGridTextColumn Header="数据" Binding="{Binding DataText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </GroupBox>

            <!-- 通道工具 -->
            <GroupBox Header="通道工具" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="清空收发缓冲" Style="{StaticResource PrimaryButton}" Click="BtnClearBuf_Click"/>
                    <Button Content="重置CAN通道" Style="{StaticResource WarningButton}" Click="BtnReset_Click" Margin="8,0,0,0"/>
                    <Button Content="读取待收帧数" Style="{StaticResource PrimaryButton}" Click="BtnReadNum_Click" Margin="8,0,0,0"/>
                    <TextBlock Text="待收:" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12"/>
                    <TextBlock x:Name="TxtRecvNum" Text="—" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="   CAN  /  " VerticalAlignment="Center" Foreground="#667" FontSize="11"/>
                    <TextBlock x:Name="TxtRecvNumFd" Text="—" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="  CANFD" VerticalAlignment="Center" Foreground="#667" FontSize="11"/>
                    <TextBlock x:Name="TxtToolResult" Text="" VerticalAlignment="Center" Foreground="#28a745" Margin="18,0,0,0" FontSize="12"/>
                    <TextBlock Text="（连接由主界面启动时自动建立）" VerticalAlignment="Center" Foreground="#AAA" Margin="18,0,0,0" FontSize="11"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
