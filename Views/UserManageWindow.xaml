<Window x:Class="AgingTest.Views.UserManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户管理"
        Width="780" Height="600"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#EFF2F7" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="UMBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#1F3864" CornerRadius="6" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="用户管理" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUserCount" Text="" FontSize="12" Foreground="#AFC4E8" VerticalAlignment="Center" Margin="14,1,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtCurrentUser" Text="" FontSize="12" Foreground="#FFD9A8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 用户列表 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="6">
            <DataGrid x:Name="UserGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="All"
                      BorderThickness="0" RowHeight="34" FontSize="13"
                      Background="White" Foreground="#333"
                      MouseDoubleClick="UserGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="1.2*"/>
                    <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="角色" Binding="{Binding RoleName}" Width="0.8*"/>
                    <DataGridTextColumn Header="账号ID" Binding="{Binding Id}" Width="2.2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="BtnAdd" Content="新 增" Style="{StaticResource UMBtn}" Background="#2F80ED" Click="BtnAdd_Click" AutomationProperties.AutomationId="UMBtnAdd"/>
            <Button x:Name="BtnEdit" Content="修 改" Style="{StaticResource UMBtn}" Background="#ED9A2C" Click="BtnEdit_Click" AutomationProperties.AutomationId="UMBtnEdit"/>
            <Button x:Name="BtnDelete" Content="删 除" Style="{StaticResource UMBtn}" Background="#E5484D" Click="BtnDelete_Click" AutomationProperties.AutomationId="UMBtnDelete"/>
            <Button Content="关 闭" Style="{StaticResource UMBtn}" Background="#8899AA" Click="BtnClose_Click" AutomationProperties.AutomationId="UMBtnClose"/>
        </StackPanel>

        <!-- 新增/修改表单 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#D5DCE6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="TxtFormTitle" Text="新增用户" FontSize="13" FontWeight="Bold" Foreground="#1F3864" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="用户名（登录账号）" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtUserName" Height="30" FontSize="13" VerticalContentAlignment="Center" Padding="6,0" AutomationProperties.AutomationId="UMUserName"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="显示名" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtDisplayName" Height="30" FontSize="13" VerticalContentAlignment="Center" Padding="6,0" AutomationProperties.AutomationId="UMDisplayName"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="密码" Style="{StaticResource FormLabel}"/>
                        <PasswordBox x:Name="PwdPassword" Height="30" FontSize="13" VerticalContentAlignment="Center" Padding="6,0" AutomationProperties.AutomationId="UMPassword"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="角色权限" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="CmbRole" Height="30" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.AutomationId="UMRole">
                            <ComboBoxItem Content="作业员" Tag="Operator"/>
                            <ComboBoxItem Content="技术员" Tag="Technician"/>
                            <ComboBoxItem Content="工程师" Tag="Engineer"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="BtnSave" Grid.Column="4" Content="保 存" Style="{StaticResource UMBtn}" Background="#2FA84F" Height="30" Margin="0,20,8,0" VerticalAlignment="Bottom" Click="BtnSave_Click" AutomationProperties.AutomationId="UMBtnSave"/>
                    <Button Grid.Column="5" Content="清 空" Style="{StaticResource UMBtn}" Background="#8899AA" Height="30" Margin="0,20,0,0" VerticalAlignment="Bottom" Click="BtnClear_Click" AutomationProperties.AutomationId="UMBtnClear"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
