<UserControl x:Class="AgingTest.Views.UC_CanZlg800H"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <!-- 本页由宿主窗口(CommunicationSettingsWindow)的外层 ScrollViewer 统一滚动 -->
    <StackPanel Margin="12">
        <TextBlock Text="ZLG CANFDNET-800U 连接" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="每台 CAN 盒只需填写 IP 地址和端口号（该盒通道0的端口，通道1~7 依次 +1）。点击「连接」后程序自动完成：打开设备 → 下发 8 个通道的 IP/端口 → 通道初始化 → 通道启动。"
                   Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- 全局协议（所有 CAN 盒共用） -->
        <WrapPanel Margin="0,0,0,12">
            <TextBlock Text="协议：" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox x:Name="CmbProtocol" Width="110" FontSize="12" Margin="6,0,0,0" SelectedIndex="0"
                      SelectionChanged="CmbProtocol_SelectionChanged">
                <ComboBoxItem Content="CAN"/>
                <ComboBoxItem Content="CANFD"/>
            </ComboBox>
            <TextBlock Text="CANFD加速：" VerticalAlignment="Center" FontSize="12" Margin="16,0,0,0"/>
            <ComboBox x:Name="CmbFdAcc" Width="80" FontSize="12" Margin="6,0,0,0" SelectedIndex="1">
                <ComboBoxItem Content="是"/>
                <ComboBoxItem Content="否"/>
            </ComboBox>
            <TextBlock Text="（协议须与设备端「控制器类型」一致；波特率/终端电阻在设备端配置）"
                       VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="11" Margin="14,0,0,0"/>
        </WrapPanel>

        <!-- 每台 CAN 盒一行 -->
        <StackPanel x:Name="WrapCanCards"/>
    </StackPanel>
</UserControl>
