<UserControl x:Class="AgingTest.Views.UC_ChargeTest"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             Background="#F4F6F9"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="10,6,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28a745"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="ParamBox" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D0D7E3" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="层号" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbLayer" Width="70" Height="28" SelectionChanged="CmbLayer_SelectionChanged"/>
                    <TextBlock x:Name="TxtSelectedCount" Text="已选 8 工位" FontSize="12" Foreground="#6B7280" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSvcState" Text="空闲" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="默认映射：奇数列单工位 / 偶数列双工位，可在表格中修改" FontSize="11" Foreground="#9CA3AF" Margin="18,0,0,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnStart" Content="开始充电测试" Style="{StaticResource SuccessButton}" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Content="停止充电测试" Style="{StaticResource DangerButton}" Click="BtnStop_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左工位表 + 右参数 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="工位与设备映射（第 1 层）" x:Name="GrpStations" Style="{StaticResource GroupBoxStyle}">
                <DataGrid x:Name="GridStations" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30"
                          FontSize="12" Background="White" BorderThickness="0" IsReadOnly="False"
                          CurrentCellChanged="GridStations_CurrentCellChanged"
                          CellEditEnding="GridStations_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, Mode=TwoWay}" Width="42"/>
                        <DataGridTextColumn Header="工位" Binding="{Binding Station.Code}" Width="60" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="双工位" Binding="{Binding IsDual, Mode=TwoWay}" Width="62"/>
                        <DataGridTextColumn Header="设备映射" Binding="{Binding MapText}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="工艺参数" Style="{StaticResource GroupBoxStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="负载 VON (V)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtLoadVon" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="负载限流 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtLoadCurrent" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="小电源电压 (V)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtSmallVolt" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="小电源限流 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtSmallLimit" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="大电源电压 (V)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtBigVolt" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="大电源限流 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtBigLimit" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="单工位目标电流 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtPerStation" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="总电流允差 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtTolerance" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="小电源电流上限 (A)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtSmallMax" Style="{StaticResource ParamBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="唤醒超时 (ms)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtWakeTimeout" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="电芯温度电阻 (kΩ)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtTempRes" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="烘箱温度 (℃)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtOvenTemp" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="烘箱湿度 (%)" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtOvenHum" Style="{StaticResource ParamBox}"/>
                            <CheckBox x:Name="ChkOven" Content="启用烘箱" FontSize="12" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkStopOven" Content="停止时同时停烘箱" FontSize="12" Margin="0,0,0,10"/>
                            <TextBlock Text="指示灯 CTL（0=不控制）" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtIndicatorCtl" Style="{StaticResource ParamBox}"/>
                            <TextBlock Text="指示灯继电器地址" Style="{StaticResource ParamLabel}"/>
                            <TextBox x:Name="TxtIndicatorAddr" Style="{StaticResource ParamBox}"/>
                            <Border Background="#FFF7E6" BorderBrush="#FFE0A3" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8A5A00"
                                           Text="默认：层=485列，4块继电器板地址17~20；奇数列用CTL18/2/4/9/11与电阻CH1~3，偶数列用CTL20/6/8/13/15与CH5~7。如现场不同，请修改表格“双工位”勾选并反馈。"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- 日志 -->
        <GroupBox Grid.Row="2" Header="流程日志" Style="{StaticResource GroupBoxStyle}" Margin="0,0,0,0">
            <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="11" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="#FBFCFE"/>
        </GroupBox>
    </Grid>
</UserControl>
