<UserControl x:Class="AgingTest.Views.UC_N36100Power"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200"
             Background="#F4F6F9"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F27022"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28a745"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- 通讯状态 -->
            <GroupBox Header="通讯状态（连接/断开在【通讯设置】中操作）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="电源选择:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbDev" Width="100" SelectedIndex="0"/>
                        <TextBlock Text="（共 6 台，各自独立 IP）" VerticalAlignment="Center" Foreground="#888" Margin="14,0,0,0" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="网口通讯:" VerticalAlignment="Center" Foreground="#667" FontSize="12"/>
                        <TextBlock x:Name="TxtConnState" Text="未连接" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 输出设定区 -->
            <GroupBox Header="输出设定（普通模式）" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="输出电压(V):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtVolt" Width="120" Text="10"/>
                            <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetVolt_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="限流电流(A):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCurr" Width="120" Text="1"/>
                            <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetCurr_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="模拟内阻(mΩ):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtRes" Width="120" Text="0"/>
                            <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetRes_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="电压上升(ms):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtVolRt" Width="120" Text="100"/>
                            <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetVolRt_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="电流上升(ms):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCurRt" Width="120" Text="100"/>
                            <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetCurRt_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="输出 开启" Style="{StaticResource SuccessButton}" Click="BtnOutOn_Click"/>
                            <Button Content="输出 关闭" Style="{StaticResource DangerButton}" Click="BtnOutOff_Click"/>
                            <Button Content="设为普通模式" Style="{StaticResource PrimaryButton}" Click="BtnModeNormal_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 回读区 -->
            <GroupBox Header="输出回读" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="电压:" Width="50" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMeasV" Text="—" FontFamily="Consolas" FontSize="18" Foreground="#2F6FED" Width="110"/>
                        <TextBlock Text="V" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="电流:" Width="50" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMeasA" Text="—" FontFamily="Consolas" FontSize="18" Foreground="#F27022" Width="110"/>
                        <TextBlock Text="A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="功率:" Width="50" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtMeasW" Text="—" FontFamily="Consolas" FontSize="18" Foreground="#7A5AF8" Width="110"/>
                        <TextBlock Text="W" VerticalAlignment="Center"/>
                        <Button Content="回读" Style="{StaticResource PrimaryButton}" Click="BtnMeasure_Click" Margin="16,0,0,0"/>
                        <Button Content="读取输出状态" Style="{StaticResource PrimaryButton}" Click="BtnOutState_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 保护区 -->
            <GroupBox Header="保护设定" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="过压OVP(V):" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOvp" Width="90" Text="0"/>
                        <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetOvp_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <TextBlock Text="过流OCP(A):" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOcp" Width="90" Text="0"/>
                        <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetOcp_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="过功率OPP(W):" Width="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOpp" Width="90" Text="0"/>
                        <Button Content="设定" Style="{StaticResource PrimaryButton}" Click="BtnSetOpp_Click" Margin="8,0,0,0"/>
                        <Button Content="读取告警" Style="{StaticResource PrimaryButton}" Click="BtnAlarm_Click" Margin="12,0,0,0"/>
                        <Button Content="清除告警" Style="{StaticResource PrimaryButton}" Click="BtnClearAlarm_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 日志 -->
            <GroupBox Header="通信日志" Style="{StaticResource GroupBoxStyle}">
                <ListBox x:Name="LstLog" Height="200" FontFamily="Consolas" FontSize="12"/>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
