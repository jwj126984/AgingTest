<UserControl x:Class="AgingTest.Views.UC_OvenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200"
             Background="#F4F6F9"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28a745"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F27022"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFD"/>
            <Setter Property="BorderBrush" Value="#E2E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#7A8699"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 实时状态 -->
            <GroupBox Header="烘箱实时状态（Modbus TCP · 只读寄存器 7990~8043）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="DotOven" Width="10" Height="10" Fill="#C0C4CC" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtConn" Text="未连接" FontSize="12" Foreground="#888" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTimestamp" Text="" FontSize="11" Foreground="#9AA3B2" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Button Content="立即刷新" Style="{StaticResource PrimaryButton}" Click="BtnRefresh_Click" Margin="16,0,0,0" Padding="10,3" MinWidth="70"/>
                    </StackPanel>

                    <UniformGrid Columns="4" Rows="2">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="当前温度 (7991)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtCurrentTemp" Text="—" Style="{StaticResource CardValue}" Foreground="#2F6FED" FontSize="26"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="设定温度 (8024)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtSetTemp" Text="—" Style="{StaticResource CardValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="当前湿度 (7992)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtHumidity" Text="—" Style="{StaticResource CardValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="运行状态 (7990)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtRunning" Text="未知" Style="{StaticResource CardValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="累计运行时间 (8043/8042)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtRunTime" Text="—" Style="{StaticResource CardValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="当前段次 (8034)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtSection" Text="—" Style="{StaticResource CardValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="预计完成时间 (8012~8016)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtFinish" Text="—" Style="{StaticResource CardValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="照明状态 (8010)" Style="{StaticResource CardLabel}"/>
                                <TextBlock x:Name="TxtLight" Text="—" Style="{StaticResource CardValue}" FontSize="18"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </GroupBox>

            <!-- 温度/湿度设定 -->
            <GroupBox Header="定值设定（保持寄存器 8100 温度 / 8101 湿度 · 分辨率 0.1℃）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="温度设定:" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtInputTemp" Width="90" Height="26" FontSize="12" VerticalContentAlignment="Center"
                                 Margin="8,0,0,0" Text="40.0"/>
                        <TextBlock Text="℃（-100.0 ~ 300.0）" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button Content="下发温度" Style="{StaticResource SuccessButton}" Click="BtnSetTemp_Click" Margin="16,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="湿度设定:" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtInputHumidity" Width="90" Height="26" FontSize="12" VerticalContentAlignment="Center"
                                 Margin="8,0,0,0" Text="50.0"/>
                        <TextBlock Text="%（0 ~ 100）" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button Content="下发湿度" Style="{StaticResource SuccessButton}" Click="BtnSetHumidity_Click" Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 运行控制 -->
            <GroupBox Header="运行控制（线圈：启动 8000 / 停止 8001 / 暂停 8029 / 继续 8103 / 故障复位 8002）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="启动运行" Style="{StaticResource SuccessButton}" Click="BtnStart_Click" MinWidth="100"/>
                    <Button Content="停止运行" Style="{StaticResource DangerButton}" Click="BtnStop_Click" MinWidth="100"/>
                    <Button Content="暂停" Style="{StaticResource PrimaryButton}" Click="BtnPause_Click"/>
                    <Button Content="继续运行" Style="{StaticResource PrimaryButton}" Click="BtnResume_Click"/>
                    <Button Content="故障复位" Style="{StaticResource WarningButton}" Click="BtnFaultReset_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <!-- 辅助功能 -->
            <GroupBox Header="辅助功能（照明 8010 · 程式跳段 8006 · 保持 8007 · 自整定 8014/8015）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="照明开" Style="{StaticResource PrimaryButton}" Click="BtnLightOn_Click"/>
                    <Button Content="照明关" Style="{StaticResource PrimaryButton}" Click="BtnLightOff_Click"/>
                    <Button Content="程式跳段" Style="{StaticResource PrimaryButton}" Click="BtnSkip_Click"/>
                    <Button Content="保持" Style="{StaticResource PrimaryButton}" Click="BtnHold_Click"/>
                    <Button Content="温度自整定" Style="{StaticResource PrimaryButton}" Click="BtnAutoTuneTemp_Click"/>
                    <Button Content="湿度自整定" Style="{StaticResource PrimaryButton}" Click="BtnAutoTuneHum_Click" Margin="0"/>
                </StackPanel>
            </GroupBox>

            <!-- 日志 -->
            <Border Background="#FFFFFF" BorderBrush="#D0D7E3" BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="操作日志" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,6"/>
                    <ListBox x:Name="LogList" Height="120" FontSize="11" BorderThickness="0" Background="#F8FAFD"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
