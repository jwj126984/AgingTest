<UserControl x:Class="AgingTest.Views.UC_RelayBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="#F4F6F9"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D0D7E3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Grid.Row="0" Margin="8,4,0,4" ContentSource="Header">
                                <ContentPresenter.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937"/>
                                    </DataTemplate>
                                </ContentPresenter.ContentTemplate>
                            </ContentPresenter>
                            <ContentPresenter Grid.Row="1" Margin="8" ContentSource="Content"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#F27022"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#dc3545"/>
        </Style>
        <Style x:Key="RelayToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="#B0B8C4" Background="#EEF1F5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#28a745" TargetName="Bd"/>
                                <Setter Property="BorderBrush" Value="#28a745" TargetName="Bd"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">

            <!-- 继电器区 -->
            <GroupBox Header="继电器控制（CTL1~CTL24）" Style="{StaticResource GroupBoxStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="板卡选择:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="485列" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <ComboBox x:Name="CmbCol" Width="70" SelectedIndex="0"/>
                        <TextBlock Text="地址(17~20)" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <ComboBox x:Name="CmbAddr" Width="70" IsEditable="True" SelectedIndex="0"/>
                        <TextBlock Text="（共 24 块继电器板：6列×4地址，地址可编辑）" VerticalAlignment="Center" Foreground="#888" Margin="14,0,0,0" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="通讯状态:" VerticalAlignment="Center" Foreground="#667" FontSize="12"/>
                        <TextBlock x:Name="TxtConnState" Text="未连接" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                        <TextBlock Text="（连接/断开在【通讯设置】中操作）" VerticalAlignment="Center" Foreground="#AAA" Margin="12,0,0,0" FontSize="11"/>
                        <Button Content="全部闭合" Style="{StaticResource PrimaryButton}" Click="BtnAllOn_Click" Margin="16,0,0,0"/>
                        <Button Content="全部断开" Style="{StaticResource DangerButton}" Click="BtnAllOff_Click"/>
                        <TextBlock x:Name="TxtRelayState" Text="" VerticalAlignment="Center" Margin="16,0,0,0" FontFamily="Consolas"/>
                    </StackPanel>
                    <WrapPanel x:Name="RelayPanel"/>
                </StackPanel>
            </GroupBox>

            <!-- PWM 区 -->
            <GroupBox Header="软件 PWM（0x0720/0x0722 频率+占空比）" Style="{StaticResource GroupBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="PWM1 频率(Hz):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPwm1Freq" Width="110" Text="1000"/>
                            <TextBlock Text="占空比(%):" Width="80" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox x:Name="TxtPwm1Duty" Width="70" Text="20"/>
                            <Button Content="设置 PWM1" Style="{StaticResource PrimaryButton}" Click="BtnSetPwm1_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IPWM1 回采:" Width="110" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtIpwm1" Text="—" FontFamily="Consolas" VerticalAlignment="Center" Width="180"/>
                            <Button Content="读回" Style="{StaticResource PrimaryButton}" Click="BtnReadIpwm1_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="PWM2 频率(Hz):" Width="110" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPwm2Freq" Width="110" Text="1000"/>
                            <TextBlock Text="占空比(%):" Width="80" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox x:Name="TxtPwm2Duty" Width="70" Text="80"/>
                            <Button Content="设置 PWM2" Style="{StaticResource PrimaryButton}" Click="BtnSetPwm2_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IPWM2 回采:" Width="110" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtIpwm2" Text="—" FontFamily="Consolas" VerticalAlignment="Center" Width="180"/>
                            <Button Content="读回" Style="{StaticResource PrimaryButton}" Click="BtnReadIpwm2_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 状态区 -->
            <GroupBox Header="设备状态" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="读取状态" Style="{StaticResource PrimaryButton}" Click="BtnReadStatus_Click"/>
                    <Button Content="读取固件版本" Style="{StaticResource PrimaryButton}" Click="BtnReadVersion_Click"/>
                    <TextBlock x:Name="TxtStatus" Text="" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- 日志 -->
            <GroupBox Header="通信日志" Style="{StaticResource GroupBoxStyle}">
                <ListBox x:Name="LstLog" Height="200" FontFamily="Consolas" FontSize="12"/>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
